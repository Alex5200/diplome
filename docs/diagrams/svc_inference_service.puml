@startuml inference_service_diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 9
skinparam rectangleBorderColor #333333
skinparam rectangleFontColor #000000
skinparam rectangleFontSize 10
skinparam arrowColor #333333
skinparam arrowThickness 2
skinparam packageBorderColor #333333
skinparam packageFontColor #333333
rectangle "Inference Service" as MAIN #FFFFFF
rectangle "Hugging Face Hub" as Hugging_Face_Hub_0 #FAFAFA
MAIN --> Hugging_Face_Hub_0 : "make_policy pretrained"
rectangle "CameraService" as CameraService_1 #FAFAFA
MAIN --> CameraService_1 : "get_frame RGB 640x480"
rectangle "RobotService" as RobotService_2 #FAFAFA
MAIN --> RobotService_2 : "move_to_position per joint"
legend right
  GPU CUDA TF32 < 10 ms
end legend
@enduml