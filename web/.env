# Production Environment Variables
# Copy this file to .env and fill in the values

# Authentication
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ALGO=HS256
TOKEN_EXP_H=24
ADMIN_PASSWORD=admin
OPERATOR_PASSWORD=operator

# Auth mode (set to "false" to always require auth)
AUTH_ENABLED=true

# No-auth mode secret (only works when AUTH_ENABLED=false)
NO_AUTH_SECRET=

# Mock mode for development without hardware
MOCK_MODE=false

# Server
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO