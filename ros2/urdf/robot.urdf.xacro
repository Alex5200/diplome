<?xml version="1.0"?>
<!--
  ST3215 6-DOF Robot Manipulator — URDF with ros2_control hardware block.

  DH-параметры (из app/models/kinematics.py):
    L0 = 19  mm  — основание (base offset Z)
    L1 = 134 mm  — звено 1 (shoulder)
    L2 = 95  mm  — звено 2 (elbow)
    L3 = 34  mm  — звено 3 (wrist 1)
    L4 = 35  mm  — звено 4 (wrist 2)
    L5 = 0   mm  — звено 5 (gripper offset)

  Диапазон суставов: [-π, π] рад  (позиция 0–4095 → -180°…+180°)
  hardware plugin: mock_components/GenericSystem
    → реальное управление железом через ros2_control_bridge.py

  Координаты ros2_control:
    command_interface: position
    state_interface:   position, velocity
-->
<robot name="st3215_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══════════════════════════════════════════════════════════
       PROPERTIES
  ═══════════════════════════════════════════════════════════ -->
  <xacro:property name="L0"  value="0.019"/>   <!-- m -->
  <xacro:property name="L1"  value="0.134"/>
  <xacro:property name="L2"  value="0.095"/>
  <xacro:property name="L3"  value="0.034"/>
  <xacro:property name="L4"  value="0.035"/>

  <xacro:property name="PI"       value="3.14159265358979"/>
  <xacro:property name="J_LIMIT"  value="${PI}"/>
  <xacro:property name="J_VEL"    value="${PI}"/>    <!-- rad/s max -->
  <xacro:property name="J_EFF"    value="10.0"/>     <!-- N·m -->

  <!-- ═══════════════════════════════════════════════════════════
       MATERIAL
  ═══════════════════════════════════════════════════════════ -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- ═══════════════════════════════════════════════════════════
       LINKS
  ═══════════════════════════════════════════════════════════ -->
  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.030" length="${L0}"/></geometry>
      <origin xyz="0 0 ${L0/2}" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 ${L0/2}"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="link_0">
    <visual>
      <geometry><cylinder radius="0.025" length="${L1}"/></geometry>
      <origin xyz="0 0 ${L1/2}" rpy="0 0 0"/>
      <material name="light_grey"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 ${L1/2}"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="link_1">
    <visual>
      <geometry><cylinder radius="0.022" length="${L2}"/></geometry>
      <origin xyz="0 0 ${L2/2}" rpy="0 0 0"/>
      <material name="light_grey"/>
    </visual>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 ${L2/2}"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.00008" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="link_2">
    <visual>
      <geometry><cylinder radius="0.018" length="${L3}"/></geometry>
      <origin xyz="0 0 ${L3/2}" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <inertial>
      <mass value="0.08"/>
      <origin xyz="0 0 ${L3/2}"/>
      <inertia ixx="0.00005" iyy="0.00005" izz="0.00002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="link_3">
    <visual>
      <geometry><cylinder radius="0.016" length="${L4}"/></geometry>
      <origin xyz="0 0 ${L4/2}" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <inertial>
      <mass value="0.06"/>
      <origin xyz="0 0 ${L4/2}"/>
      <inertia ixx="0.00003" iyy="0.00003" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="link_4">
    <visual>
      <geometry><sphere radius="0.012"/></geometry>
      <origin xyz="0 0 0"/>
      <material name="light_grey"/>
    </visual>
    <inertial>
      <mass value="0.03"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.000005" iyy="0.000005" izz="0.000005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="tool_link"/>

  <!-- ═══════════════════════════════════════════════════════════
       JOINTS
  ═══════════════════════════════════════════════════════════ -->

  <!-- World → base (fixed) -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Joint 0 — вращение вокруг Z (поворот основания) -->
  <joint name="joint_0" type="revolute">
    <parent link="base_link"/>
    <child link="link_0"/>
    <origin xyz="0 0 ${L0}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Joint 1 — подъём плеча (вращение вокруг Y) -->
  <joint name="joint_1" type="revolute">
    <parent link="link_0"/>
    <child link="link_1"/>
    <origin xyz="0 0 ${L1}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Joint 2 — сгибание локтя (вращение вокруг Y) -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 ${L2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.08" friction="0.04"/>
  </joint>

  <!-- Joint 3 — запястье вверх/вниз (вращение вокруг Y) -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 ${L3}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.06" friction="0.03"/>
  </joint>

  <!-- Joint 4 — поворот запястья (вращение вокруг Z) -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 ${L4}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Joint 5 — поворот инструмента (вращение вокруг Z) -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.04" friction="0.02"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════
       ROS2_CONTROL HARDWARE INTERFACE
       plugin: mock_components/GenericSystem
         - принимает команды position
         - возвращает state = last commanded position
       Реальное управление железом выполняется через
       ros2_control_bridge.py, который слушает /joint_states
       и пишет в RobotHWInterface.
  ═══════════════════════════════════════════════════════════ -->
  <ros2_control name="ST3215RobotSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <!-- Задержка при переходе в position mode, мс -->
      <param name="calculate_dynamics">false</param>
    </hardware>

    <joint name="joint_0">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="joint_4">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="joint_5">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

  </ros2_control>

</robot>
