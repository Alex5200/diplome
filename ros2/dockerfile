FROM osrf/ros:humble-desktop

# Install dependencies (with || true for network resilience)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3-colcon-common-extensions \
        python3-pip \
        ros-humble-launch-xml \
        ros-humble-launch-yaml \
        ros-humble-gazebo-ros-pkgs \
        ros-humble-gazebo-ros2-control \
        ros-humble-gazebo-plugins \
    || true \
    && rm -rf /var/lib/apt/lists/*

# Copy from build context (parent dir with app/ and ros2/ siblings)
WORKDIR /ws

# Copy app module (for hardware_interface imports)
COPY app /ws/app/

# Copy ros2 package source (will be removed after build)
COPY ros2 /ws/robot_control/

# Copy TUI script (persists after source removal)
COPY ros2/robot_tui.py /ws/robot_tui.py

# Install Python deps
RUN pip3 install --no-cache-dir rich || true

# Build package from /ws so install/ goes to /ws/install/
RUN . /opt/ros/humble/setup.sh && \
    cd /ws && \
    colcon build --packages-select robot_control 2>&1 || echo "Build may have warnings"

# Remove source to avoid shadowing installed package
# The installed version in /ws/install/ is the one to use
RUN rm -rf /ws/robot_control

# Environment
ENV ROS_DOMAIN_ID=42
ENV PYTHONPATH="/ws/app"

WORKDIR /ws

# Entrypoint script
COPY --chmod=755 <<'EOF' /entrypoint.sh
#!/bin/bash
set -e

source /opt/ros/humble/setup.bash
source /ws/install/setup.bash

# Append /ws/app to PYTHONPATH for hardware_interface imports
export PYTHONPATH="/ws/app:${PYTHONPATH}"

echo "=== Robot Control Container ==="
echo "Available topics:"
ros2 topic list 2>/dev/null || echo "No topics yet"

echo ""
echo "Waiting for robot node..."
echo "Run 'make run-robot' inside container or use docker exec"
echo ""
echo "Tip: Map USB device with: --device=/dev/ttyUSB0"
echo ""

exec "$@"
EOF

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]
