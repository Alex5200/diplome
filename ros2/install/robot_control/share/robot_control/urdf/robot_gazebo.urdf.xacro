<?xml version="1.0"?>
<!--
  ST3215 6-DOF Robot Manipulator — Gazebo simulation URDF.

  Отличия от robot.urdf.xacro:
    1. Визуальная геометрия может быть STL-мешем (use_meshes:=true)
       или примитивами-цилиндрами (use_meshes:=false, по умолчанию).
    2. Collision-геометрия: упрощённые цилиндры/боксы для физики.
    3. Hardware plugin: gazebo_ros2_control/GazeboSystem (не mock).
    4. <gazebo> блок: плагин ros2_control + материалы.

  Запуск:
    ros2 launch robot_control gazebo.launch.py
    ros2 launch robot_control gazebo.launch.py use_meshes:=true

  Место для STL-файлов: ros2/meshes/
    base_link.stl  — основание
    link_0.stl     — плечо (shoulder)
    link_1.stl     — верхняя рука (upper arm)
    link_2.stl     — предплечье (forearm)
    link_3.stl     — запястье 1 (wrist 1)
    link_4.stl     — запястье 2 (wrist 2 + tool)
-->
<robot name="st3215_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══════════════════════════════════════════════════════════
       ARGUMENTS
  ═══════════════════════════════════════════════════════════ -->

  <!-- Путь к файлу контроллеров (передаётся из launch-файла) -->
  <xacro:arg name="robot_controllers" default=""/>

  <!--
    Использовать STL-меши (true) или цилиндрические примитивы (false).
    Установите true после замены placeholder-файлов в meshes/ на реальные.
  -->
  <xacro:arg name="use_meshes" default="false"/>
  <xacro:property name="use_meshes" value="$(arg use_meshes)"/>

  <!-- ═══════════════════════════════════════════════════════════
       PROPERTIES  (DH-параметры, мм→м)
  ═══════════════════════════════════════════════════════════ -->
  <xacro:property name="L0"  value="0.019"/>
  <xacro:property name="L1"  value="0.134"/>
  <xacro:property name="L2"  value="0.095"/>
  <xacro:property name="L3"  value="0.034"/>
  <xacro:property name="L4"  value="0.035"/>

  <xacro:property name="PI"      value="3.14159265358979"/>
  <xacro:property name="J_LIMIT" value="${PI}"/>
  <xacro:property name="J_VEL"   value="${PI}"/>
  <xacro:property name="J_EFF"   value="10.0"/>

  <!-- Путь к папке с мешами -->
  <xacro:property name="mesh_path" value="package://robot_control/meshes"/>

  <!-- ═══════════════════════════════════════════════════════════
       MATERIALS  (URDF/RViz)
  ═══════════════════════════════════════════════════════════ -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- ═══════════════════════════════════════════════════════════
       LINKS
  ═══════════════════════════════════════════════════════════ -->

  <link name="world"/>

  <!-- ── base_link: основание ────────────────────────────────── -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${L0/2}" rpy="0 0 0"/>
      <geometry>
        <xacro:if value="${use_meshes == 'true'}">
          <mesh filename="${mesh_path}/base_link.stl"/>
        </xacro:if>
        <xacro:unless value="${use_meshes == 'true'}">
          <cylinder radius="0.030" length="${L0}"/>
        </xacro:unless>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${L0/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="${L0}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 ${L0/2}"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── link_0: плечо (shoulder rotation) ──────────────────── -->
  <link name="link_0">
    <visual>
      <origin xyz="0 0 ${L1/2}" rpy="0 0 0"/>
      <geometry>
        <xacro:if value="${use_meshes == 'true'}">
          <mesh filename="${mesh_path}/link_0.stl"/>
        </xacro:if>
        <xacro:unless value="${use_meshes == 'true'}">
          <cylinder radius="0.025" length="${L1}"/>
        </xacro:unless>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${L1/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="${L1}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 ${L1/2}"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── link_1: верхняя рука (upper arm) ───────────────────── -->
  <link name="link_1">
    <visual>
      <origin xyz="0 0 ${L2/2}" rpy="0 0 0"/>
      <geometry>
        <xacro:if value="${use_meshes == 'true'}">
          <mesh filename="${mesh_path}/link_1.stl"/>
        </xacro:if>
        <xacro:unless value="${use_meshes == 'true'}">
          <cylinder radius="0.022" length="${L2}"/>
        </xacro:unless>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${L2/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="${L2}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 ${L2/2}"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.00008" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── link_2: предплечье (forearm) ───────────────────────── -->
  <link name="link_2">
    <visual>
      <origin xyz="0 0 ${L3/2}" rpy="0 0 0"/>
      <geometry>
        <xacro:if value="${use_meshes == 'true'}">
          <mesh filename="${mesh_path}/link_2.stl"/>
        </xacro:if>
        <xacro:unless value="${use_meshes == 'true'}">
          <cylinder radius="0.018" length="${L3}"/>
        </xacro:unless>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${L3/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="${L3}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <origin xyz="0 0 ${L3/2}"/>
      <inertia ixx="0.00005" iyy="0.00005" izz="0.00002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── link_3: запястье 1 (wrist 1) ───────────────────────── -->
  <link name="link_3">
    <visual>
      <origin xyz="0 0 ${L4/2}" rpy="0 0 0"/>
      <geometry>
        <xacro:if value="${use_meshes == 'true'}">
          <mesh filename="${mesh_path}/link_3.stl"/>
        </xacro:if>
        <xacro:unless value="${use_meshes == 'true'}">
          <cylinder radius="0.016" length="${L4}"/>
        </xacro:unless>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${L4/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="${L4}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.06"/>
      <origin xyz="0 0 ${L4/2}"/>
      <inertia ixx="0.00003" iyy="0.00003" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── link_4: запястье 2 / tool mount ────────────────────── -->
  <link name="link_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <xacro:if value="${use_meshes == 'true'}">
          <mesh filename="${mesh_path}/link_4.stl"/>
        </xacro:if>
        <xacro:unless value="${use_meshes == 'true'}">
          <sphere radius="0.014"/>
        </xacro:unless>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.000005" iyy="0.000005" izz="0.000005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- tool_link: виртуальное звено (точка крепления инструмента) -->
  <link name="tool_link"/>

  <!-- ═══════════════════════════════════════════════════════════
       JOINTS  (идентичны robot.urdf.xacro)
  ═══════════════════════════════════════════════════════════ -->

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint_0" type="revolute">
    <parent link="base_link"/>
    <child link="link_0"/>
    <origin xyz="0 0 ${L0}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <joint name="joint_1" type="revolute">
    <parent link="link_0"/>
    <child link="link_1"/>
    <origin xyz="0 0 ${L1}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 ${L2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.4" friction="0.08"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 ${L3}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.3" friction="0.06"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 ${L4}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-J_LIMIT}" upper="${J_LIMIT}" effort="${J_EFF}" velocity="${J_VEL}"/>
    <dynamics damping="0.2" friction="0.04"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════
       ROS2_CONTROL — Gazebo hardware plugin
       Замечание: Gazebo сам запускает controller_manager.
       Контроллеры запускаются через spawner в launch-файле.
  ═══════════════════════════════════════════════════════════ -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint_0">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>

    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>

    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>

    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>

    <joint name="joint_4">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>

    <joint name="joint_5">
      <command_interface name="position">
        <param name="min">${-J_LIMIT}</param>
        <param name="max">${J_LIMIT}</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>

  </ros2_control>

  <!-- ═══════════════════════════════════════════════════════════
       GAZEBO PLUGIN — ros2_control
       Получает путь к yaml через xacro-аргумент robot_controllers.
  ═══════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(arg robot_controllers)</parameters>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       GAZEBO MATERIALS + SURFACE PROPERTIES per link
  ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link_0">
    <material>Gazebo/Grey</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link_1">
    <material>Gazebo/Grey</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link_2">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link_3">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link_4">
    <material>Gazebo/Grey</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

</robot>
